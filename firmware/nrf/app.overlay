#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
&qspi { status = "disabled"; };
&spi4 { status = "disabled"; };
&spi3 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&uart1 { status = "disabled"; };
&clock { hfclkaudio-frequency = <12288000>; };
&pinctrl {
    adapter_i2s: adapter_i2s {
        group1 {
            psels = <NRF_PSEL(I2S_SCK_M, 1, 4)>,
                    <NRF_PSEL(I2S_LRCK_M, 1, 5)>,
                    <NRF_PSEL(I2S_SDOUT, 1, 7)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
        group2 {
            psels = <NRF_PSEL(I2S_SDIN, 1, 6)>;
        };
    };
};
&i2s0 {
    status = "okay";
    pinctrl-0 = <&adapter_i2s>;
    pinctrl-names = "default";
    clock-source = "ACLK";
};
